# ============================================
# Portfolio Backend — Environment Configuration
# ============================================

# Port d'écoute du serveur Node.js (défaut: 3000)
PORT=3000

# Mot de passe administrateur pour l'accès au tableau de bord /admin.html
# ATTENTION : Définissez un mot de passe robuste et ne commitez JAMAIS le fichier .env !
ADMIN_PASSWORD=change_this_secure_password_123!
